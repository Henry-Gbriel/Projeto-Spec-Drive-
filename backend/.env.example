# Copie para .env e preencha. O arquivo .env nunca é versionado.
# Conexão do papel `coletor` (rotinas de coleta). Na nuvem: pooler em modo sessão, porta 5432.
COLETOR_DATABASE_URL=
# Conexão do papel `api_leitura` (API). Na nuvem: pooler em modo transação, porta 6543.
API_DATABASE_URL=
# Origens autorizadas a chamar a API (separadas por vírgula).
CORS_ORIGENS=http://localhost:5173
# local | producao
AMBIENTE=local
